      "id": "allocationMainScreenMerge",
      "type": "xor",
      "name": "Before Allocation Main Screen",
      "doc": "SYNTHESIZED: not a documented node. 3 flows reach 'Allocation Main Screen'; this converging exclusive gateway merges them."
    },
    {
      "id": "allocationMainScreen",
      "type": "userTask",
      "name": "Allocation Main Screen",
      "doc": "Interface: NSSOL_SEC_Allocation (D04 ¶168–237). Flow: D03 ¶80–91. Inputs: rule inputs at D04 ¶174–184. PROPOSAL (AL-7): outputs are the flags the buttons set (D03 ¶88–91) and the lists D04 ¶179–180 describe as passed back to PV. Candidate group NP Users (AL-1).",
      "inputs": [
        "projectInfo",
        "selectedEmployees",
        "selectedSubcontractors",
        "assignedEmployees",
        "assignedSubcontractors",
        "isAddEmployee",
        "isAddSubcontractor",
        "isAssign",
        "allocationCancel"
      ],
      "outputs": [
        "assignedEmployees",
        "assignedSubcontractors",
        "isAddEmployee",
        "isAddSubcontractor",
        "isAssign",
        "allocationCancel"
      ],
      "candidateGroups": [
        "NP Users"
      ]
    },
    {
      "id": "allocationMainScreenGateway",
      "type": "xor",
      "name": "After Allocation Main Screen",
      "doc": "SYNTHESIZED: not a documented node. The branches at D03 ¶93–115 leave 'Allocation Main Screen' directly; this exclusive gateway carries their conditions."
    },
    {
      "id": "end1",
      "type": "end",
      "name": "End",
      "doc": "Flow: D03 ¶93."
    },
    {
      "id": "employeeSearchScreen",
      "type": "userTask",
      "name": "Employee Search Screen",
      "doc": "Interface: NSSOL_GRID_Employee_Search_Screen (D04 ¶241–251). Flow: D03 ¶98–101. PROPOSAL (AL-7): outputs from D03 ¶101–102. Candidate group NP Users (AL-1). No rule inputs are documented for this interface.",
      "inputs": [],
      "outputs": [
        "selectedEmployees",
        "empCancel"
      ],
      "candidateGroups": [
        "NP Users"
      ]
    },
    {
      "id": "subcontractorSearchScreen",
      "type": "userTask",
      "name": "Subcontractor Search Screen",
      "doc": "Interface: NSSOL_GRID_Subcontractor_Search_Screen (D04 ¶255–265). Flow: D03 ¶108–111. PROPOSAL (AL-7): outputs from D03 ¶111–112. Candidate group NP Users (AL-1). No rule inputs are documented for this interface.",
      "inputs": [],
      "outputs": [
        "selectedSubcontractors",
        "SubconCancel"
      ],
      "candidateGroups": [
        "NP Users"
      ]
    },
    {
      "id": "allocationConfirmation",
      "type": "userTask",
      "name": "Allocation Confirmation",
      "doc": "Interface: NSSOL_FRM_Allocation_Confirmation (D04 ¶83–97). Flow: D03 ¶118–121. Inputs: rule inputs at D04 ¶89–91. PROPOSAL (AL-7): outputs from D04 ¶96. Candidate group NP Users (AL-1). AL-C2: D04 ¶97 documents Back as form behaviour leaving the task open.",
      "inputs": [
        "projectInfo"
      ],
      "outputs": [
        "assignedEmployees",
        "assignedSubcontractors"
      ],
      "candidateGroups": [
        "NP Users"
      ]
    },
    {
      "id": "writeMapEmployeeRecords",
      "type": "serviceTask",
      "name": "Write Map Employee Records",
      "doc": "Flow: D03 ¶124–126. AL-4: untyped in the diagram; MapEmployeeStore is a proposed test double. Saves assignedEmployees to NSSOL Map Employees (D03 ¶125–126); write semantics unspecified.",
      "service": {
        "class": "nssol.service.MapEmployeeStore",
        "operation": "save"
      },
      "inputs": [
        "assignedEmployees"
      ],
      "outputs": [
        "assignedEmployees"
      ]
    },
    {
      "id": "writeMapSubcontractorRecords",
      "type": "serviceTask",
      "name": "Write Map Subcontractor Records",
      "doc": "Flow: D03 ¶129–130. AL-4: untyped in the diagram; MapSubcontractorStore is a proposed test double. Saves assignedSubcontractors to NSSOL Map Subcontractors (D03 ¶130); write semantics unspecified.",
      "service": {
        "class": "nssol.service.MapSubcontractorStore",
        "operation": "save"
      },
      "inputs": [
        "assignedSubcontractors"
      ],
      "outputs": [
        "assignedSubcontractors"
      ]
    },
    {
      "id": "end2",
      "type": "end",
      "name": "End",
      "doc": "Flow: D03 ¶133."
    }
  ],
  "flows": [
    {
      "from": "start",
      "to": "allocationMainScreenMerge"
    },
    {
      "from": "allocationMainScreen",
      "to": "allocationMainScreenGateway"
    },
    {
      "from": "allocationMainScreenGateway",
      "to": "end1",
      "name": "allocationCancel = true",
      "default": true
    },
    {
      "from": "allocationMainScreenGateway",
      "to": "employeeSearchScreen",
      "name": "isAddEmployee = true",
      "priority": 1,
      "condition": "return isAddEmployee != null && isAddEmployee;"
    },
    {
      "from": "employeeSearchScreen",
      "to": "allocationMainScreenMerge",
      "name": "empCancel = true / confirm"
    },
    {
      "from": "allocationMainScreenGateway",
      "to": "subcontractorSearchScreen",
      "name": "isAddSubcontractor = true",
      "priority": 2,
      "condition": "return isAddSubcontractor != null && isAddSubcontractor;"
    },
    {
      "from": "subcontractorSearchScreen",
      "to": "allocationMainScreenMerge",
      "name": "SubconCancel = true / confirm"
    },
    {
      "from": "allocationMainScreenGateway",
      "to": "allocationConfirmation",
      "name": "isAssign = true",
      "priority": 3,
      "condition": "return isAssign != null && isAssign;"
    },
    {
      "from": "allocationConfirmation",
      "to": "writeMapEmployeeRecords"
    },
    {
      "from": "writeMapEmployeeRecords",
      "to": "writeMapSubcontractorRecords"
    },
    {
      "from": "writeMapSubcontractorRecords",
      "to": "end2"
    },
    {
      "from": "allocationMainScreenMerge",
      "to": "allocationMainScreen"
    }
  ],
  "tests": [
    {
      "name": "cancel_writesNothing",
      "start": {
        "projectInfo": {
          "projectId": 3,
          "projectName": "Test Tower Construction",
          "isActive": true
        }
      },
      "steps": [
        {
          "task": "allocationMainScreen",
          "complete": {
            "allocationCancel": true
          }
        }
      ],
      "expect": {
        "status": "COMPLETED",
        "saves": {
          "MapEmployeeStore": 0,
          "MapSubcontractorStore": 0
        }
      }
    },
    {
      "name": "assign_savesEmployeesAndSubcontractors",
      "start": {
        "projectInfo": {
          "projectId": 3,
          "projectName": "Test Tower Construction",
          "isActive": true
        }
      },
      "steps": [
        {
          "task": "allocationMainScreen",
          "complete": {
            "isAssign": true,
            "assignedEmployees": [
              {
                "employeeMappedId": 1,
                "projectId": 3,
                "employeeId": 10,
                "role": "Site Manager"
              }
            ],
            "assignedSubcontractors": [
              {
                "subconMappedId": 1,
                "projectId": 3,
                "subconId": 20,
                "companyName": "Acme Subcontracting"
              }
            ]
          }
        },
        {
          "task": "allocationConfirmation",
          "complete": {
            "assignedEmployees": [
              {
                "employeeMappedId": 1,
                "projectId": 3,
                "employeeId": 10,
                "role": "Site Manager"
              }
            ],
            "assignedSubcontractors": [
              {
                "subconMappedId": 1,
                "projectId": 3,
                "subconId": 20,
                "companyName": "Acme Subcontracting"
              }
            ]
          }
        }
      ],
      "expect": {
        "status": "COMPLETED",
        "saves": {
          "MapEmployeeStore": 1,
          "MapSubcontractorStore": 1
        },
        "savedLists": {
          "MapEmployeeStore": 1,
          "MapSubcontractorStore": 1
        }
      }
    },
    {
      "name": "addEmployee_returnsToMainScreenThenCancels",
      "start": {
        "projectInfo": {
          "projectId": 3,
          "projectName": "Test Tower Construction",
          "isActive": true
        }
      },
      "steps": [
        {
          "task": "allocationMainScreen",
          "complete": {
            "isAddEmployee": true
          }
        },
        {
          "task": "employeeSearchScreen",
          "complete": {
            "selectedEmployees": [
              {
                "empId": 10,
                "empName": "Test Employee"
              }
            ],
            "empCancel": false
          }
        },
        {
          "task": "allocationMainScreen",
          "complete": {
            "allocationCancel": true
          }
        }
      ],
      "expect": {
        "status": "COMPLETED",
        "saves": {
          "MapEmployeeStore": 0,
          "MapSubcontractorStore": 0
        }
      }
    },
    {
      "name": "defaultFlow_noFlagsSetEndsWithoutSaving",
      "start": {
        "projectInfo": {
          "projectId": 3,
          "projectName": "Test Tower Construction",
          "isActive": true
        }
      },
      "steps": [
        {
          "task": "allocationMainScreen",
          "complete": {}
        }
      ],
      "expect": {
        "status": "COMPLETED",
        "saves": {
          "MapEmployeeStore": 0,
          "MapSubcontractorStore": 0
        }
      }
    }
  ],
  "assumptions": [
    {
      "id": "AL-1",
      "text": "DRAFT-RESOLVED (pending user approval): candidate group NP Users assigned to all four user tasks; group choice is an analyst proposal, not documented."
    },
    {
      "id": "AL-2",
      "text": "DRAFT-RESOLVED (pending user approval): cancel flow is default (ends without saving) and search/confirm flows have priorities 1–3; precedence and default are analyst rules, not documented (D03 ¶93–115)."
    },
    {
      "id": "AL-3",
      "text": "DRAFT-RESOLVED (pending user approval): form contract requires the main-screen task to return all four flags on every completion, resetting prior loop-back flags (D03 ¶102–103, ¶112–113)."
    },
    {
      "id": "AL-4",
      "text": "DRAFT-RESOLVED (pending user approval): write nodes modelled as service tasks (D03 ¶124, ¶129) with MapEmployeeStore and MapSubcontractorStore test doubles; real write semantics unspecified."
    },
    {
      "id": "AL-C1",
      "text": "DRAFT-RESOLVED (pending user approval): summary table at D03 ¶220 is out of date; model follows the diagram (D03 ¶118–119) and D04 ¶84–97 with 4 user tasks."
    },
