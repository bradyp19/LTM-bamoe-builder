      "name": "Start",
      "doc": "Flow: D03 ¶76–77."
    },
    {
      "id": "allocationMainScreen",
      "type": "userTask",
      "name": "Allocation Main Screen",
      "doc": "Interface: NSSOL_SEC_Allocation (D04 ¶168–237). Flow: D03 ¶80–91. Inputs: rule inputs at D04 ¶174–184. PROPOSAL (AL-7): outputs are the flags the buttons set (D03 ¶88–91) and the lists D04 ¶179–180 describe as passed back to PV. No documented assignee (AL-1).",
      "inputs": [
        "projectInfo",
        "selectedEmployees",
        "selectedSubcontractors",
        "assignedEmployees",
        "assignedSubcontractors",
        "isAddEmployee",
        "isAddSubcontractor",
        "isAssign",
        "allocationCancel"
      ],
      "outputs": [
        "assignedEmployees",
        "assignedSubcontractors",
        "isAddEmployee",
        "isAddSubcontractor",
        "isAssign",
        "allocationCancel"
      ]
    },
    {
      "id": "allocationMainScreenGateway",
      "type": "xor",
      "name": "After Allocation Main Screen",
      "doc": "SYNTHESIZED: not a documented node. The branches at D03 ¶93–115 leave 'Allocation Main Screen' directly; this exclusive gateway carries their conditions."
    },
    {
      "id": "end1",
      "type": "end",
      "name": "End",
      "doc": "Flow: D03 ¶93."
    },
    {
      "id": "employeeSearchScreen",
      "type": "userTask",
      "name": "Employee Search Screen",
      "doc": "Interface: NSSOL_GRID_Employee_Search_Screen (D04 ¶241–251). Flow: D03 ¶98–101. PROPOSAL (AL-7): outputs from D03 ¶101–102. No rule inputs are documented for this interface.",
      "inputs": [],
      "outputs": [
        "selectedEmployees",
        "empCancel"
      ]
    },
    {
      "id": "subcontractorSearchScreen",
      "type": "userTask",
      "name": "Subcontractor Search Screen",
      "doc": "Interface: NSSOL_GRID_Subcontractor_Search_Screen (D04 ¶255–265). Flow: D03 ¶108–111. PROPOSAL (AL-7): outputs from D03 ¶111–112. No rule inputs are documented for this interface.",
      "inputs": [],
      "outputs": [
        "selectedSubcontractors",
        "SubconCancel"
      ]
    },
    {
      "id": "allocationConfirmation",
      "type": "userTask",
      "name": "Allocation Confirmation",
      "doc": "Interface: NSSOL_FRM_Allocation_Confirmation (D04 ¶83–97). Flow: D03 ¶118–121. Inputs: rule inputs at D04 ¶89–91. PROPOSAL (AL-7): outputs from D04 ¶96. AL-C2 CONFLICT: D04 ¶97 documents a Back button; the diagram has no path back.",
      "inputs": [
        "projectInfo"
      ],
      "outputs": [
        "assignedEmployees",
        "assignedSubcontractors"
      ]
    },
    {
      "id": "writeMapEmployeeRecords",
      "type": "serviceTask",
      "name": "Write Map Employee Records",
      "doc": "Flow: D03 ¶124–126. AL-4: untyped in the diagram; MapEmployeeStore is a proposed test double. Saves assignedEmployees to NSSOL Map Employees (D03 ¶125–126); write semantics unspecified.",
      "service": {
        "class": "nssol.service.MapEmployeeStore",
        "operation": "save"
      },
      "inputs": [
        "assignedEmployees"
      ],
      "outputs": [
        "assignedEmployees"
      ]
    },
    {
      "id": "writeMapSubcontractorRecords",
      "type": "serviceTask",
      "name": "Write Map Subcontractor Records",
      "doc": "Flow: D03 ¶129–130. AL-4: untyped in the diagram; MapSubcontractorStore is a proposed test double. Saves assignedSubcontractors to NSSOL Map Subcontractors (D03 ¶130); write semantics unspecified.",
      "service": {
        "class": "nssol.service.MapSubcontractorStore",
        "operation": "save"
      },
      "inputs": [
        "assignedSubcontractors"
      ],
      "outputs": [
        "assignedSubcontractors"
      ]
    },
    {
      "id": "end2",
      "type": "end",
      "name": "End",
      "doc": "Flow: D03 ¶133."
    }
