  "flows": [
    {
      "from": "start",
      "to": "allocationMainScreen"
    },
    {
      "from": "allocationMainScreen",
      "to": "allocationMainScreenGateway"
    },
    {
      "from": "allocationMainScreenGateway",
      "to": "end1",
      "name": "allocationCancel = true",
      "condition": "return allocationCancel != null && allocationCancel;"
    },
    {
      "from": "allocationMainScreenGateway",
      "to": "employeeSearchScreen",
      "name": "isAddEmployee = true",
      "condition": "return isAddEmployee != null && isAddEmployee;"
    },
    {
      "from": "employeeSearchScreen",
      "to": "allocationMainScreen",
      "name": "empCancel = true / confirm"
    },
    {
      "from": "allocationMainScreenGateway",
      "to": "subcontractorSearchScreen",
      "name": "isAddSubcontractor = true",
      "condition": "return isAddSubcontractor != null && isAddSubcontractor;"
    },
    {
      "from": "subcontractorSearchScreen",
      "to": "allocationMainScreen",
      "name": "SubconCancel = true / confirm"
    },
    {
      "from": "allocationMainScreenGateway",
      "to": "allocationConfirmation",
      "name": "isAssign = true",
      "condition": "return isAssign != null && isAssign;"
    },
    {
      "from": "allocationConfirmation",
      "to": "writeMapEmployeeRecords"
    },
    {
      "from": "writeMapEmployeeRecords",
      "to": "writeMapSubcontractorRecords"
    },
    {
      "from": "writeMapSubcontractorRecords",
      "to": "end2"
    }
  ],
  "tests": [],
  "assumptions": [
    {
      "id": "AL-1",
      "text": "No task assignee/candidate group documented; the four user tasks are left unassigned (same gap as SR-3)."
    },
    {
      "id": "AL-2",
      "text": "Branch precedence and default are undocumented (D03 ¶93–115): nothing says which flag wins if several are true, or what happens if none is. Conditions are emitted in document order with no default flow."
    },
    {
      "id": "AL-3",
      "text": "Flag reset on loop-back is undocumented (D03 ¶102–103, ¶112–113): nothing clears isAddEmployee / isAddSubcontractor when a search screen returns, so the same branch is taken again unless the form resets the flag."
    },
    {
      "id": "AL-4",
      "text": "The two write nodes carry no task type in the diagram (D03 ¶124, ¶129); modelled as service tasks. MapEmployeeStore and MapSubcontractorStore are proposed test doubles; real write semantics unspecified (same gap as SR-4)."
    },
    {
      "id": "AL-C1",
      "text": "CONFLICT: D03 ¶220 counts 3 forms (allocation + 2 search); the flow diagram has a fourth user task, Allocation Confirmation (D03 ¶118–119). Model follows the diagram."
    },
    {
      "id": "AL-C2",
      "text": "CONFLICT: D04 ¶97 gives Allocation Confirmation a Back button returning to the allocation screen; the flow diagram shows no path back from it (D03 ¶118–124). Model follows the diagram: no back flow."
    },
    {
      "id": "AL-5",
      "text": "Process name template is dynamic (D03 ¶49); the BPMN process name is the static model name."
    },
    {
      "id": "AL-6",
      "text": "The documented projectInfo default (D03 ¶61) is not carried into the spec."
    },
    {
      "id": "AL-7",
      "text": "Target-design proposals pending approval: class names (ProjectRegistration reused for NSSOL Projects; Employee, Subcontractor, MapEmployee, MapSubcontractor), DateTime as java.time.LocalDateTime, list variables as java.util.List, and every user-task output."
    },
    {
      "id": "AL-8",
      "text": "Cancelling a search screen is documented as returning without selection (D04 ¶251); the merged return flow carries no condition, so nothing in the process enforces it."
    },
    {
      "id": "T-1",
      "text": "Gateway 'After Allocation Main Screen' is synthesized: the branches at D03 ¶93–115 leave 'Allocation Main Screen' directly and no gateway is documented."
    },
    {
      "id": "T-2",
      "text": "Branches 'empCancel = true' and 'confirm' (D03 ¶102–103) both lead from 'Employee Search Screen' to 'Allocation Main Screen'; emitted as one flow with no condition."
    },
    {
      "id": "T-3",
      "text": "Branches 'SubconCancel = true' and 'confirm' (D03 ¶112–113) both lead from 'Subcontractor Search Screen' to 'Allocation Main Screen'; emitted as one flow with no condition."
    },
    {
      "id": "T-4",
      "text": "'Allocation Main Screen' has 3 incoming flows (from 'start', 'employeeSearchScreen', 'subcontractorSearchScreen'); no merge gateway is documented and none is emitted."
    }
  ]
}
