      "start": {
        "notes": "Record actions f2204bff (New, isUpdate=false) / 60ca774a (Edit, isUpdate=true). D03 ¶248–256.",
        "support": [
          {"cite": "D03 ¶252", "quote": "`f2204bff-28bb-4ea4-95e1-03f8f0784890` | New Project (toolbar button) | NSSOL Register Project (isUpdate=false)"},
          {"cite": "D03 ¶253", "quote": "`60ca774a-e1d1-4e93-9424-c042270865e1` | Edit Project (row edit icon) | NSSOL Register Project (isUpdate=true)"}
