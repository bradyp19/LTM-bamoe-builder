        "support": [
          {"cite": "D04 ¶353–358", "quote": "Provides Back and Confirm buttons."},
          {"cite": "D04 ¶77", "quote": "Submit triggers `a!save` to write back to `pv!projectRegistration`"},
          {"cite": "D04 ¶78", "quote": "Cancel sets `pv!cancel = true`"}
        ]
      },
      "saveRecord": {
        "service": {"class": "nssol.service.ProjectStore", "operation": "save"},
        "inputs": ["projectRegistration"],
        "outputs": ["projectRegistration"],
        "notes": "Create or update NSSOL_PROJECTS row (D03 Figure 1). SR-4: write semantics unspecified; ProjectStore is a test double."
      }
    }
  },
  "assumptions": [
    {"id": "SR-3", "text": "No task assignee/candidate group documented; user task left unassigned."},
    {"id": "SR-5", "text": "cancel=null treated as not-cancelled (no documented default)."},
    {"id": "SR-4", "text": "ProjectStore is an in-memory test double; real write semantics unspecified."},
    {"id": "C1", "text": "Model follows Figure 1: no confirmation node. D04 §14 confirmation section unresolved.",
     "support": [
       {"cite": "D04 ¶356", "quote": "Intermediate confirmation step after user fills the project registration form"}
     ]},
    {"id": "C2", "text": "Status requiredness unresolved (D03 ¶38 required vs D04 ¶48 unmarked vs D05 ¶59 nullable); no enforcement coded.",
     "support": [
       {"cite": "D03 ¶38", "quote": "Required fields enforced in the form: project name, order amount (million yen), expected order amount, status"},
       {"cite": "D04 ¶48", "quote": "| Status | Dropdown | Values: NSSOL_LIST_TXT_STATUS (Completed, In-Progress) |"},
       {"cite": "D05 ¶59", "quote": "| `status` | Text | Yes |"}
