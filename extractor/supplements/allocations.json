{
  "process": "NSSOL Allocations",
  "design": {
    "process": {
      "descriptionTemplate": "NSSOL Allocations - #{projectInfo.projectName}"
    },
    "models": {
      "NSSOL Projects": "ProjectRegistration",
      "NSSOL Employees": "Employee",
      "NSSOL Subcontractors": "Subcontractor",
      "NSSOL Map Employees": "MapEmployee",
      "NSSOL Map Subcontractors": "MapSubcontractor"
    },
    "typeMap": {"DateTime": "java.time.LocalDateTime"},
    "flowRules": {
      "allocationMainScreenGateway->end1": {"default": true},
      "allocationMainScreenGateway->employeeSearchScreen": {"priority": 1},
      "allocationMainScreenGateway->subcontractorSearchScreen": {"priority": 2},
      "allocationMainScreenGateway->allocationConfirmation": {"priority": 3}
    },
    "nodes": {
      "allocationMainScreen": {
        "candidateGroups": ["NP Users"],
        "outputs": ["assignedEmployees", "assignedSubcontractors", "isAddEmployee",
                    "isAddSubcontractor", "isAssign", "allocationCancel"],
        "notes": "PROPOSAL (AL-7): outputs are the flags the buttons set (D03 ¶88–91) and the lists D04 ¶179–180 describe as passed back to PV. Candidate group NP Users (AL-1).",
        "support": [
          {"cite": "D03 ¶88", "quote": "sets isAddEmployee=true"},
          {"cite": "D03 ¶91", "quote": "sets allocationCancel=true"},
          {"cite": "D04 ¶179", "quote": "(passed back to PV)"},
          {"cite": "D04 ¶180", "quote": "(passed back to PV)"}
        ]
      },
      "employeeSearchScreen": {
        "candidateGroups": ["NP Users"],
        "outputs": ["selectedEmployees", "empCancel"],
        "notes": "PROPOSAL (AL-7): outputs from D03 ¶101–102. Candidate group NP Users (AL-1). No rule inputs are documented for this interface.",
        "support": [
          {"cite": "D03 ¶101", "quote": "Selected employees stored in pv!selectedEmployees"},
          {"cite": "D03 ¶102", "quote": "[empCancel = true]"}
        ]
      },
      "subcontractorSearchScreen": {
        "candidateGroups": ["NP Users"],
        "outputs": ["selectedSubcontractors", "SubconCancel"],
        "notes": "PROPOSAL (AL-7): outputs from D03 ¶111–112. Candidate group NP Users (AL-1). No rule inputs are documented for this interface.",
        "support": [
          {"cite": "D03 ¶111", "quote": "Selected subcontractors stored in pv!selectedSubcontractors"},
          {"cite": "D03 ¶112", "quote": "[SubconCancel = true]"}
        ]
      },
      "allocationConfirmation": {
        "candidateGroups": ["NP Users"],
        "outputs": ["assignedEmployees", "assignedSubcontractors"],
        "notes": "PROPOSAL (AL-7): outputs from D04 ¶96. Candidate group NP Users (AL-1). AL-C2: D04 ¶97 documents Back as form behaviour leaving the task open.",
        "support": [
          {"cite": "D04 ¶96", "quote": "saving the assigned employee/subcontractor lists to the process variables"},
          {"cite": "D04 ¶97", "quote": "**Back** button: returns to allocation screen"}
        ]
      },
      "writeMapEmployeeRecords": {
        "type": "serviceTask",
        "service": {"class": "nssol.service.MapEmployeeStore", "operation": "save"},
        "inputs": ["assignedEmployees"],
        "outputs": ["assignedEmployees"],
        "notes": "AL-4: untyped in the diagram; MapEmployeeStore is a proposed test double. Saves assignedEmployees to NSSOL Map Employees (D03 ¶125–126); write semantics unspecified.",
        "support": [
          {"cite": "D03 ¶125", "quote": "Saves pv!assignedEmployees to NSSOL Map Employees record type"}
        ]
      },
      "writeMapSubcontractorRecords": {
        "type": "serviceTask",
        "service": {"class": "nssol.service.MapSubcontractorStore", "operation": "save"},
        "inputs": ["assignedSubcontractors"],
        "outputs": ["assignedSubcontractors"],
        "notes": "AL-4: untyped in the diagram; MapSubcontractorStore is a proposed test double. Saves assignedSubcontractors to NSSOL Map Subcontractors (D03 ¶130); write semantics unspecified.",
        "support": [
          {"cite": "D03 ¶130", "quote": "Saves pv!assignedSubcontractors to NSSOL Map Subcontractors record type"}
        ]
      }
    }
  },
  "assumptions": [
    {"id": "AL-1", "text": "DRAFT-RESOLVED (pending user approval): candidate group NP Users assigned to all four user tasks; group choice is an analyst proposal, not documented."},
    {"id": "AL-2", "text": "DRAFT-RESOLVED (pending user approval): cancel flow is default (ends without saving) and search/confirm flows have priorities 1–3; precedence and default are analyst rules, not documented (D03 ¶93–115).",
     "support": [
       {"cite": "D03 ¶93", "quote": "[allocationCancel = true]"},
       {"cite": "D03 ¶95", "quote": "[isAddEmployee = true]"},
       {"cite": "D03 ¶105", "quote": "[isAddSubcontractor = true]"},
       {"cite": "D03 ¶115", "quote": "[isAssign = true]"}
     ]},
    {"id": "AL-3", "text": "DRAFT-RESOLVED (pending user approval): form contract requires the main-screen task to return all four flags on every completion, resetting prior loop-back flags (D03 ¶102–103, ¶112–113).",
     "support": [
       {"cite": "D03 ¶102–103", "quote": "back to Allocation Main Screen with selectedEmployees populated"},
       {"cite": "D03 ¶112–113", "quote": "back to Allocation Main Screen with selectedSubcontractors populated"}
     ]},
    {"id": "AL-4", "text": "DRAFT-RESOLVED (pending user approval): write nodes modelled as service tasks (D03 ¶124, ¶129) with MapEmployeeStore and MapSubcontractorStore test doubles; real write semantics unspecified.",
     "support": [
       {"cite": "D03 ¶124", "quote": "[Write Map Employee Records]"},
       {"cite": "D03 ¶129", "quote": "[Write Map Subcontractor Records]"}
     ]},
    {"id": "AL-C1", "text": "DRAFT-RESOLVED (pending user approval): summary table at D03 ¶220 is out of date; model follows the diagram (D03 ¶118–119) and D04 ¶84–97 with 4 user tasks.",
     "support": [
       {"cite": "D03 ¶220", "quote": "| Forms Involved | 1 (registration) | 3 (allocation + 2 search) | 0 |"},
       {"cite": "D03 ¶118–119", "quote": "Interface: NSSOL_FRM_Allocation_Confirmation"}
     ]},
    {"id": "AL-C2", "text": "DRAFT-RESOLVED (pending user approval): Back on Allocation Confirmation (D04 ¶97) is form behaviour leaving the task open; model follows the diagram (D03 ¶118–124) with no back flow.",
     "support": [
       {"cite": "D04 ¶97", "quote": "**Back** button: returns to allocation screen"},
       {"cite": "D03 ¶118–124", "quote": "[Write Map Employee Records]"}
     ]},
    {"id": "AL-5", "text": "DRAFT-RESOLVED (pending user approval): dynamic process name template configured via descriptionTemplate (D03 ¶49).",
     "support": [
       {"cite": "D03 ¶49", "quote": "\"NSSOL Allocations - \" & pv!projectInfo[projectName]"}
     ]},
    {"id": "AL-6", "text": "DRAFT-RESOLVED (pending user approval): hardcoded dev default (D03 ¶61) dropped; projectInfo is required input.",
     "support": [
       {"cite": "D03 ¶61", "quote": "projectId = 3 (default for dev)"}
     ]},
    {"id": "AL-7", "text": "DRAFT-RESOLVED (pending user approval): target-design proposals approved: class names (ProjectRegistration reused for NSSOL Projects; Employee, Subcontractor, MapEmployee, MapSubcontractor), DateTime as java.time.LocalDateTime, list variables as java.util.List, and user-task outputs."},
    {"id": "AL-8", "text": "DRAFT-RESOLVED (pending user approval): search-screen cancel without selection (D04 ¶251) is handled as form contract; merged return flow has no gateway condition.",
     "support": [
       {"cite": "D04 ¶251", "quote": "Cancel → returns without selection (sets `empCancel=true`)"}
     ]}
  ],
  "tests": [
    {
      "name": "cancel_writesNothing",
      "start": {
        "projectInfo": {
          "projectId": 3,
          "projectName": "Test Tower Construction",
          "isActive": true
        }
      },
      "steps": [
        {
          "task": "allocationMainScreen",
          "complete": {
            "allocationCancel": true
          }
        }
      ],
      "expect": {
        "status": "COMPLETED",
        "saves": {
          "MapEmployeeStore": 0,
          "MapSubcontractorStore": 0
        }
      }
    },
    {
      "name": "assign_savesEmployeesAndSubcontractors",
      "start": {
        "projectInfo": {
          "projectId": 3,
          "projectName": "Test Tower Construction",
          "isActive": true
        }
      },
      "steps": [
        {
          "task": "allocationMainScreen",
          "complete": {
            "isAssign": true,
            "assignedEmployees": [
              {
                "employeeMappedId": 1,
                "projectId": 3,
                "employeeId": 10,
                "role": "Site Manager"
              }
            ],
            "assignedSubcontractors": [
              {
                "subconMappedId": 1,
                "projectId": 3,
                "subconId": 20,
                "companyName": "Acme Subcontracting"
              }
            ]
          }
        },
        {
          "task": "allocationConfirmation",
          "complete": {
            "assignedEmployees": [
              {
                "employeeMappedId": 1,
                "projectId": 3,
                "employeeId": 10,
                "role": "Site Manager"
              }
            ],
            "assignedSubcontractors": [
              {
                "subconMappedId": 1,
                "projectId": 3,
                "subconId": 20,
                "companyName": "Acme Subcontracting"
              }
            ]
          }
        }
      ],
      "expect": {
        "status": "COMPLETED",
        "saves": {
          "MapEmployeeStore": 1,
          "MapSubcontractorStore": 1
        },
        "savedLists": {
          "MapEmployeeStore": 1,
          "MapSubcontractorStore": 1
        }
      }
    },
    {
      "name": "addEmployee_returnsToMainScreenThenCancels",
      "start": {
        "projectInfo": {
          "projectId": 3,
          "projectName": "Test Tower Construction",
          "isActive": true
        }
      },
      "steps": [
        {
          "task": "allocationMainScreen",
          "complete": {
            "isAddEmployee": true
          }
        },
        {
          "task": "employeeSearchScreen",
          "complete": {
            "selectedEmployees": [
              {
                "empId": 10,
                "empName": "Test Employee"
              }
            ],
            "empCancel": false
          }
        },
        {
          "task": "allocationMainScreen",
          "complete": {
            "allocationCancel": true
          }
        }
      ],
      "expect": {
        "status": "COMPLETED",
        "saves": {
          "MapEmployeeStore": 0,
          "MapSubcontractorStore": 0
        }
      }
    },
    {
      "name": "defaultFlow_noFlagsSetEndsWithoutSaving",
      "start": {
        "projectInfo": {
          "projectId": 3,
          "projectName": "Test Tower Construction",
          "isActive": true
        }
      },
      "steps": [
        {
          "task": "allocationMainScreen",
          "complete": {}
        }
      ],
      "expect": {
        "status": "COMPLETED",
        "saves": {
          "MapEmployeeStore": 0,
          "MapSubcontractorStore": 0
        }
      }
    }
  ]
}
